<Window x:Class="WinUiSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="origami winui spike">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Machine">
                <MenuFlyoutItem Text="Start"/>
                <MenuFlyoutItem Text="Stop"/>
            </MenuBarItem>
        </MenuBar>
        <SwapChainPanel x:Name="Display" Grid.Row="1"/>
    </Grid>
</Window>
